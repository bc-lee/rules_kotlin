diff --git a/BUILD b/BUILD
new file mode 100644
index 0000000..1a7e9be
--- /dev/null
+++ b/BUILD
@@ -0,0 +1,17 @@
+load("@rules_java//java:defs.bzl", "java_library", "java_binary")
+
+package(default_visibility = ["//visibility:public"])
+
+java_library(
+    name = "jarjar",
+    srcs = glob(["src/main/java/org/pantsbuild/jarjar/**/*.java"], allow_empty = True),
+    resources = [
+        "src/main/java/org/pantsbuild/jarjar/help.txt",
+    ],
+    deps = [
+        "@maven//:org_apache_ant_ant",
+        "@maven//:org_ow2_asm_asm_commons",
+        "@maven//:org_ow2_asm_asm",
+        "@maven//:org_apache_maven_maven_plugin_api",
+    ],
+)
diff --git a/MODULE.bazel b/MODULE.bazel
new file mode 100644
index 0000000..47ed335
--- /dev/null
+++ b/MODULE.bazel
@@ -0,0 +1,63 @@
+module(name = "jarjar")
+
+bazel_dep(name = "rules_java", version = "8.11.0")
+bazel_dep(name = "rules_jvm_external", version = "6.7")
+
+maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
+maven.install(
+  name = "maven",
+  artifacts = [
+    "org.apache.ant:ant:1.9.9",
+    "org.ow2.asm:asm:7.0",
+    "org.ow2.asm:asm-commons:7.0",
+    "org.apache.maven:maven-plugin-api:3.3.9",
+  ],
+  repositories = [
+      "https://maven.google.com",
+      "https://repo1.maven.org/maven2",
+  ],
+)
+use_repo(maven, "maven")
+
+
